# Copie este arquivo para .env e ajuste o IP da sua máquina
# Para descobrir seu IP: hostname -I (Linux) ou ipconfig (Windows)
EXPO_PUBLIC_API_URL=http://SEU_IP_LOCAL:3001/api

# Login com Google (opcional). Client ID do tipo Web criado no Google Cloud
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Só para builds iOS
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
