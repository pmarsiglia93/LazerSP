# Copie para .env: cp .env.example .env
# Os valores abaixo servem para desenvolvimento local.

PORT=3001
NODE_ENV=development
DB_PATH=./lazersp.db

# Origens liberadas no CORS em produção, separadas por vírgula.
# Em development o CORS aceita qualquer origem.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173

# Credenciais do painel administrativo (obrigatórias para o login funcionar)
ADMIN_USER=admin
# Recomendado: hash bcrypt da senha. Gere com: npm run hash-password -- "sua-senha"
ADMIN_PASSWORD_HASH=
# Alternativa para desenvolvimento: senha em texto puro (gera um aviso no log).
# Ignorada quando ADMIN_PASSWORD_HASH está definida.
ADMIN_PASSWORD=troque-esta-senha

# Segredo de assinatura do JWT (obrigatório para o login funcionar).
# Gere um valor aleatório com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Login do app com Google: client IDs OAuth aceitos (web, Android, iOS), separados por vírgula
GOOGLE_CLIENT_IDS=
