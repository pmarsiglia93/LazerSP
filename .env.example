# Variáveis usadas pelo docker-compose.yml
# Copie para .env na raiz do projeto: cp .env.example .env

# Credenciais do painel administrativo
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Segredo de assinatura do JWT.
# Gere um valor aleatório com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origens liberadas no CORS, separadas por vírgula (padrão: http://localhost:8081)
# ALLOWED_ORIGINS=http://localhost:8081
