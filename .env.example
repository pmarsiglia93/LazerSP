# Variáveis usadas pelo docker-compose.yml
# Copie para .env na raiz do projeto: cp .env.example .env

# Credenciais do painel administrativo
ADMIN_USER=admin
# Recomendado: hash bcrypt gerado com `cd backend && npm run hash-password -- "sua-senha"`.
# Neste arquivo, o Docker Compose interpreta "$": duplique cada um ($$2b$$12$$...).
ADMIN_PASSWORD_HASH=
# Alternativa para uso local: senha em texto puro (gera um aviso no log)
ADMIN_PASSWORD=troque-esta-senha

# Segredo de assinatura do JWT.
# Gere um valor aleatório com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origens liberadas no CORS, separadas por vírgula (padrão: http://localhost:8081)
# ALLOWED_ORIGINS=http://localhost:8081

# Login do app com Google: client IDs OAuth aceitos, separados por vírgula
GOOGLE_CLIENT_IDS=
